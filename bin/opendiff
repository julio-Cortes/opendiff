#!/bin/sh

source=$0
while [ -h "$source" ]; do
  directory=$(CDPATH= cd -P -- "$(dirname -- "$source")" && pwd)
  source=$(readlink "$source")
  case $source in
    /*) ;;
    *) source=$directory/$source ;;
  esac
done

root=$(CDPATH= cd -P -- "$(dirname -- "$source")/.." && pwd)
exec bun run \
  --preload "$root/node_modules/@opentui/solid/scripts/preload.js" \
  --jsx-import-source @opentui/solid \
  "$root/src/index.tsx" "$@"
